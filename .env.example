# =====================================================================
# Nexora Wholesale - environment template (the ONLY example env file)
# ---------------------------------------------------------------------
# Copy to .env and fill in every value marked REQUIRED.
# PLACEHOLDERS ONLY. Never commit a real .env (it is git-ignored).
# The app refuses to boot if APP_KEY, APP_URL or DB_PASSWORD is empty.
# =====================================================================

APP_NAME="Nexora Wholesale"
# local | production
APP_ENV=production
# REQUIRED. Generate: php artisan key:generate --show
APP_KEY=
# Must be false in production.
APP_DEBUG=false
# REQUIRED. Public base URL, no trailing slash.
APP_URL=https://your-app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------------------------------------------------------------------
# Database - Supabase PostgreSQL (recommended)
# Supabase dashboard > Connect > "Session pooler" (IPv4-compatible).
# Use the SESSION pooler (port 5432), not the transaction pooler (6543).
# Only these DB_* values are needed: the app does NOT use the Supabase
# anon / publishable / service_role keys or the JWT secret.
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
# REQUIRED. Supabase > Project Settings > Database > Database password.
DB_PASSWORD=your_supabase_database_password_here
DB_SSLMODE=require

# ---------------------------------------------------------------------
# Sessions, cache, queue
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true when served over HTTPS (always in production); false for http://localhost.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Mail (e-mail verification). "log" writes mails to the log file.
# ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM_ADDRESS="no-reply@your-app.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Nexora Wholesale
# ---------------------------------------------------------------------
NEXORA_CURRENCY=USD
NEXORA_QUOTE_EXPIRY_DAYS=30
# Public live-demo URL (README / listing).
NEXORA_DEMO_URL=
# true = show one-click demo BUYER sign-in on /login (public demo only).
NEXORA_DEMO_MODE=false

# Product image uploads (set false on hosts without persistent disk, e.g. Vercel).
NEXORA_UPLOADS_ENABLED=true
# Vercel Cron only: long random secret; enables GET /cron/expire-quotes.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Admin created by `php artisan db:seed` ONLY if both are set.
# Leave empty and use `php artisan nexora:create-admin` instead if you prefer.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Docker only (docker-compose.yml / entrypoint)
# ---------------------------------------------------------------------
APP_PORT=8080
# Run `db:seed` on container start (idempotent).
RUN_SEED=false
