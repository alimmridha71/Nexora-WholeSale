{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nexora/wholesale",
    "type": "project",
    "description": "Nexora Wholesale - B2B wholesale ordering platform with tiered bulk pricing and custom quotes.",
    "keywords": ["laravel", "b2b", "wholesale", "bulk-pricing", "quotes"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "fakerphp/faker": "^1.24",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "pint --test"
        ],
        "audit-deps": [
            "@composer audit --locked"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "audit": {
            "abandoned": "fail"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
